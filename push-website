#!/bin/bash

if [[ "$1" == "-f" ]]; then
    FORCE_PUSH=true
else
    FORCE_PUSH=false
fi

echo ---------------
echo website-builder
echo ---------------
for d in ~/mjnurse/website-builder ~/mjnurse/mjnurse-website ~/mjnurse/mjnurse.github.io; do
    cd "$d" || exit
    commit_message=""
    git fetch
    if [[ -n "$(git status --porcelain)" ]]; then
        git status
        if $FORCE_PUSH; then
            choice="Y"
        else
            choice=""
            while [[ "$choice" == "" ]]; do
                read -p "Push changes to GitHub ([d]iff - show changes, specify commit message [c])? [dycN] " choice
                if [[ "${choice^}" == "D" ]]; then
                    git diff
                    choice=""
                elif [[ "${choice^}" == "C" ]]; then
                    read -p "Enter commit message (blank defaults to 'various'): " commit_message
                    choice="Y"
                fi
            done
        fi
        if [[ "${choice^}" == "Y" ]]; then
            git add .
            git commit -m "${commit_message:-various}"
            git pull --rebase
            git push origin main
            echo "Changes pushed to GitHub."
        fi
    else
        echo "No changes to push."
    fi
done
