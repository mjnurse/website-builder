#!/bin/bash

if [[ "$1" == "-f" ]]; then
    FORCE_PUSH=true
else
    FORCE_PUSH=false
fi

echo "===================================="
echo "Pushing website changes to GitHub..."
echo "===================================="
echo
for d in website-builder mjnurse-website mjnurse.github.io; do

    echo "${d//?/-}"
    echo "$d"
    echo "${d//?/-}"
    if [[ ! -d ~/mjnurse/$d ]]; then
        echo "Directory ~/mjnurse/$d does not exist."
        continue
    fi
    cd ~/mjnurse/$d
    commit_message=""
    git fetch
    if [[ -n "$(git status --porcelain)" ]]; then
        git status
        if $FORCE_PUSH; then
            choice="Y"
        else
            choice=""
            while [[ "$choice" == "" ]]; do
                read -p "Push changes to GitHub ([d]iff - show changes, specify commit message [c])? [dycN] " choice
                choice="${choice:-N}"
                if [[ "${choice^}" == "D" ]]; then
                    git diff
                    choice=""
                elif [[ "${choice^}" == "C" ]]; then
                    read -p "Enter commit message (blank defaults to 'various'): " commit_message
                    choice="Y"
                fi
            done
        fi
        if [[ "${choice^}" == "Y" ]]; then
            git add .
            git commit -m "${commit_message:-various}"
            git pull --rebase
            git push origin main
            echo "Changes pushed to GitHub."
        fi
    else
        echo "No changes to push."
    fi
done
