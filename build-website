#!/bin/bash

if [[ "$1" == "-d" || "$1" == "--daily" ]]; then
    today=$(date +"%Y-%m-%d")
    last_day="$(cat $HOME/.local/state/website-last_build_date.txt 2>/dev/null)"
    if [ "$today" == "$last_day" ]; then
        echo "Website already built today ($today). Skipping build."
        exit 0
    fi
    echo "$today" > $HOME/.local/state/website-last_build_date.txt
fi

cd $HOME/mjnurse/website-builder

for f in gen*.py; do
    echo "Running $f"
    python3 "$f"
done

sck -m > ../mjnurse-website/other/shortcut_keys.md
n -m > ../mjnurse-website/notes/miscellaneous_notes.md

echo "Building site"

cp $HOME/mjnurse/mjnurse-website/static/* $HOME/mjnurse/mjnurse.github.io/static
python3 build-website.py --src ../mjnurse-website --out ../mjnurse.github.io

cd $HOME/mjnurse/mjnurse.github.io
$HOME/mjnurse/website-builder/revert-date-only-changes

cd $HOME/mjnurse/website-builder
push-website $1
